{
  "name": "repo-context-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server that returns small, precise repo information",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "telemetry:summary": "node dist/telemetry/summary.js",
    "telemetry:report": "node dist/telemetry/report.js",
    "telemetry:test": "node dist/telemetry/test.js",
    "validate": "npm run build && npm run telemetry:test && npm run telemetry:summary && npm run telemetry:report",
    "test": "vitest run tests/tools.test.ts tests/telemetry.test.ts",
    "test:edge": "vitest run tests/edge.test.ts",
    "test:security": "vitest run tests/security.test.ts",
    "test:benchmark": "vitest run tests/budget.test.ts",
    "test:all": "npm run build && npm run test && npm run test:edge && npm run test:security && npm run test:benchmark && npm run benchmark:compact && npm run validate && npm run benchmark:workflow && npm run deep-test:report",
    "benchmark:compact": "node dist/benchmark/compact.js",
    "benchmark:workflow": "node dist/benchmark/workflow.js",
    "deep-test:report": "node dist/scripts/generateDeepTestReport.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shrey1110-dotcom/CLAUDE_API_SAVER.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "repo-context",
    "typescript"
  ]
}
