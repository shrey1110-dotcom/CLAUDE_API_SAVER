{
  "name": "repo-context-mcp",
  "version": "0.1.0",
  "description": "Universal MCP context broker for coding agents with compact repo graph, context packs, and telemetry.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "repo-context-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "graph:build": "node dist/graph/buildGraph.js",
    "context:build": "node dist/context/buildContext.js",
    "telemetry:clean": "node dist/scripts/cleanTelemetry.js",
    "telemetry:summary": "node dist/telemetry/summary.js",
    "telemetry:report": "node dist/telemetry/report.js",
    "telemetry:test": "node dist/telemetry/test.js",
    "telemetry:context-test": "node dist/telemetry/contextTest.js",
    "doctor": "node dist/scripts/doctor.js",
    "smoke:mcp": "node dist/scripts/smokeMcp.js",
    "release:check": "node dist/scripts/releaseCheck.js",
    "validate": "npm run build && npm run telemetry:test && npm run telemetry:summary && npm run telemetry:report",
    "test": "vitest run tests/tools.test.ts tests/telemetry.test.ts",
    "test:edge": "vitest run tests/edge.test.ts",
    "test:security": "vitest run tests/security.test.ts",
    "test:benchmark": "vitest run tests/budget.test.ts",
    "test:graph": "vitest run tests/graph.test.ts",
    "test:context": "vitest run tests/context.test.ts",
    "test:client": "vitest run tests/clientAgnostic.test.ts",
    "test:all": "npm run build && npm run test && npm run test:edge && npm run test:security && npm run test:benchmark && npm run test:graph && npm run test:context && npm run test:client && npm run test:ab && npm run benchmark:compact && npm run validate && npm run graph:build && npm run context:build && npm run benchmark:workflow && npm run benchmark:graph && npm run benchmark:context && npm run compat:report && npm run deep-test:report",
    "benchmark:compact": "node dist/benchmark/compact.js",
    "benchmark:workflow": "node dist/benchmark/workflow.js",
    "benchmark:graph": "node dist/benchmark/graph.js",
    "benchmark:context": "node dist/benchmark/context.js",
    "compat:report": "node dist/scripts/compatReport.js",
    "deep-test:report": "node dist/scripts/generateDeepTestReport.js",
    "ab:create": "node dist/ab/createPlan.js",
    "ab:prompt": "node dist/ab/printPrompt.js",
    "ab:record": "node dist/ab/recordResult.js",
    "ab:report": "node dist/ab/report.js",
    "ab:compare": "node dist/ab/compare.js",
    "ab:real-check": "node dist/ab/realCheck.js",
    "ab:codex": "node dist/ab/adapters/codexCli.js",
    "ab:codex:plan": "node dist/ab/codexPlan.js",
    "test:ab": "npm run build && vitest run tests/ab.test.ts tests/codexAdapter.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrey1110-dotcom/CLAUDE_API_SAVER.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "claude",
    "ai-coding",
    "context",
    "knowledge-graph",
    "repository-analysis"
  ]
}
